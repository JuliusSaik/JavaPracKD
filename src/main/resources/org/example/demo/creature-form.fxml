<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="410.0" prefWidth="220.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.CreatureController">
   <children>
      <TextField fx:id="nameField" layoutX="35.0" layoutY="30.0" promptText="Name" />
      <TextField fx:id="founderField" layoutX="35.0" layoutY="75.0" promptText="Founder" />
      <ComboBox fx:id="alignmentBox" layoutX="35.0" layoutY="121.0" prefWidth="150.0" />
      <DatePicker fx:id="dateFoundField" layoutX="35.0" layoutY="168.0" prefHeight="25.0" prefWidth="150.0" />
      <Button fx:id="createButton" layoutX="85.0" layoutY="360.0" mnemonicParsing="false" onAction="#createCreature" text="Create" />
      <CheckBox fx:id="endangeredCheck" layoutX="59.0" layoutY="325.0" mnemonicParsing="false" text="Is endangered?" />
      <TextArea fx:id="itemsField" layoutX="24.0" layoutY="214.0" prefHeight="91.0" prefWidth="178.0" promptText="Items" />
   </children>
</AnchorPane>
