<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="503.0" prefWidth="326.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="org.example.demo.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <ListView fx:id="magicalList" editable="true" prefHeight="172.0" prefWidth="286.0" />
      <TextField fx:id="nameField" prefHeight="7.0" prefWidth="286.0" promptText="Name" />
      <TextField fx:id="founderField" promptText="Founder" />
      <DatePicker fx:id="dateFoundPicker" />
      <ComboBox fx:id="alignmentBox" prefWidth="150.0" />
      <Button fx:id="filterButton" mnemonicParsing="false" onAction="#filterData" text="Filter" />
      <Button fx:id="createButton" mnemonicParsing="false" onAction="#openCreationForm" text="Create new creature" />
      <Button fx:id="tableviewButton" mnemonicParsing="false" onAction="#openTableview" text="Open tableview" />
   </children>
</VBox>
